{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "three", "@react-three/*", "zustand", "zustand/*"],
                "message": "src/domain is pure TypeScript: no UI, 3D or state libraries."
              },
              {
                "group": ["**/state/**", "**/scene/**", "**/features/**", "**/ui/**"],
                "message": "src/domain must not depend on the layers built on top of it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/scene/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/state/**", "**/features/**", "zustand", "zustand/*"],
                "message": "src/scene renders what it receives as props; it does not read the store or the UI."
              }
            ]
          }
        ]
      }
    }
  ]
}
